   <property name="styleSheet">
    <string notr="true">QComboBox {
    border: 2px solid #808080;   /* Grey border */
    border-radius: 10px;         /* Round the corners */
    padding: 0 8px;              /* Padding inside the combo box */
    background: #808080;         /* Grey background */
    color: white;                /* White text color */
}

/* Dropdown arrow */
QComboBox::drop-down {
    border: none;
    background: transparent;
}

/* The dropdown list */
QComboBox QAbstractItemView {
    border: 2px solid #808080;
    background: white;
    selection-background-color: #505050;  /* Darker grey on selection */
    color: black;
}

/* Hover effect */
QComboBox:hover {
    background-color: #505050;   /* Darker grey on hover */
}
</string>
